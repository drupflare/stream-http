{
	"name": "drupflare/stream-http",
	"description": "A PHP https:// stream wrapper backed by an injected fetch, for PHP-in-wasm builds that have no sockets.",
	"type": "library",
	"license": "MIT",
	"keywords": [
		"php",
		"stream-wrapper",
		"http",
		"https",
		"wasm",
		"php-wasm",
		"cloudflare",
		"workers",
		"fetch"
	],
	"homepage": "https://github.com/drupflare/stream-http",
	"authors": [
		{
			"name": "Gregory Mitchell",
			"email": "me@gmitch215.xyz",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/drupflare/stream-http/issues",
		"source": "https://github.com/drupflare/stream-http"
	},
	"require": {
		"php": "^8.3"
	},
	"require-dev": {
		"drupal/coder": "^9.0",
		"phpdocumentor/shim": "^3.10",
		"phpunit/php-code-coverage": "^11.0 || ^12.0 || ^14.0"
	},
	"autoload": {
		"psr-4": {
			"Drupflare\\StreamHttp\\": "src/"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpdocumentor/shim": true
		}
	},
	"scripts": {
		"lint": "php tests/lint.php",
		"test": [
			"@lint",
			"php tests/run-suite.php"
		],
		"cs": "phpcs",
		"cs:fix": "phpcbf",
		"coverage": "php tests/coverage.php"
	},
	"scripts-descriptions": {
		"lint": "Runs php -l over every PHP file in the package.",
		"test": "Lints, then drives the wrapper against a fake fetch.",
		"cs": "Checks coding standards with phpcs.",
		"cs:fix": "Fixes what phpcbf can fix.",
		"coverage": "Runs the suite under xdebug or pcov and writes Clover to coverage/."
	}
}
